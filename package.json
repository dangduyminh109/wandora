{
  "name": "wandora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write src scripts tests docs/*.md README.md *.json *.mjs *.ts",
    "format:check": "prettier --check src scripts tests docs/*.md README.md *.json *.mjs *.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:smoke": "tsx --env-file=.env.local scripts/smoke-auth.ts",
    "test:accounts": "tsx --env-file=.env.local scripts/smoke-accounts.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed-admin.ts",
    "db:ping-mongo": "tsx --env-file=.env.local scripts/ping-mongo.ts",
    "db:mongo-indexes": "tsx --env-file=.env.local scripts/create-mongo-indexes.ts",
    "db:seed-travel": "tsx --env-file=.env.local scripts/seed-travel.ts",
    "db:backfill-amenities": "tsx --env-file=.env.local scripts/backfill-amenities.ts",
    "bench:cache": "tsx --conditions react-server --env-file=.env.local scripts/bench-cache.ts",
    "db:init-cassandra": "tsx --env-file=.env.local scripts/init-cassandra.ts",
    "test:activity": "tsx --env-file=.env.local scripts/smoke-activity.ts",
    "db:sync-neo4j": "tsx --env-file=.env.local scripts/sync-places-neo4j.ts",
    "db:seed-interactions": "tsx --conditions react-server --env-file=.env.local scripts/seed-interactions.ts"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/geist": "^5.2.0",
    "@hookform/resolvers": "^5.9.1",
    "@mui/material": "^9.4.0",
    "@mui/material-nextjs": "^9.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "cassandra-driver": "^4.10.0",
    "jose": "^6.0.0",
    "lenis": "^1.3.27",
    "mongodb": "^7.7.0",
    "neo4j-driver": "^6.0.0",
    "next": "^16.0.0",
    "nodemailer": "^10.0.16",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.89.0",
    "redis": "^5.0.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
